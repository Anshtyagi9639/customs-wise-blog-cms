{
  "name": "customs-wise-blog-cms-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local proof of concept of the Multi-Site Blog CMS. Not for production.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 3100",
    "build": "next build --webpack",
    "start": "next start",
    "start:local": "next start -H 127.0.0.1 -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "sample-image": "node scripts/make-sample-image.mjs",
    "import:customs-wise": "node scripts/import-customs-wise.mjs",
    "test:workflow": "node scripts/test-workflow.mjs",
    "migrate:mongodb": "node scripts/migrate-json-to-mongodb.mjs",
    "mongo:local": "node scripts/mongo-local.mjs",
    "check:mongodb": "node scripts/check-mongodb.mjs",
    "check:cloudinary": "node scripts/check-cloudinary.mjs",
    "test:cloudinary-mock": "node scripts/test-cloudinary-mock.mjs",
    "test:live": "node scripts/test-live.mjs"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "lucide-react": "^1.48.0",
    "mongodb": "^7.7.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  }
}
