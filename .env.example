# Copy this file to .env.local and fill in real values there.
# .env.local is ignored by git. Never put real values in this file, in code, in a chat or in a screenshot.

# Address this app is opened at. Used to build absolute image URLs in structured data.
CMS_PUBLIC_URL=http://127.0.0.1:3100

# --- MongoDB Atlas -------------------------------------------------------------------------------------------------
# Connection string from Atlas (Database > Connect > Drivers). Use a database user that has "readWrite" on the one
# database below and nothing else. Server-side only: it is never sent to the browser or written to logs.
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/?retryWrites=true&w=majority
# Database name. Use a separate one per environment, for example blog_cms_dev and blog_cms_production.
MONGODB_DB=blog_cms_dev

# Optional. "json" forces the old JSON file store (data/db.json) even when MONGODB_URI is set.
# With MONGODB_URI empty the JSON file store is used automatically.
# CMS_STORE=

# Where uploaded images (and db.json, for the JSON file store) are kept. Defaults to ./data
# CMS_DATA_DIR=

# --- Cloudinary (image hosting) ---------------------------------------------------------------------------------
# From the Cloudinary console: Settings > API Keys. Server-side only: never sent to the browser or written to logs.
# Leave all three empty to keep new images in the local folder (data/uploads). Setting only some of them makes
# uploads fail with a message saying which one is missing.
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<numeric-api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Optional. "local" keeps new images in the local folder even when Cloudinary is configured (for test runs).
# CMS_IMAGES=

# --- Not used yet. Listed so the production shape is visible. ---
# SESSION_SECRET=
